## Deployer private key (no 0x prefix issues either way), used only for signing
## Monad Testnet deployment transactions. Never commit the real .env file.
PRIVATE_KEY=

## Optional: override the default Monad Testnet RPC URL (https://testnet-rpc.monad.xyz)
MONAD_TESTNET_RPC_URL=

## Optional: API key for Monadscan (Etherscan-compatible) contract verification
ETHERSCAN_API_KEY=
